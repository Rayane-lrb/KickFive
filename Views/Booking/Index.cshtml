    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<KickFive.Models.Booking>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer[""];
}
<div class="container py-4">
            <h1 class="h3 mb-1">Bookings</h1>
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted border rounded-3">
            <p class="mb-0">@Localizer["NoBookingsYet"]</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                var statusKey = item.Status?.ToString()?.ToLower() switch
                {
                    "confirmed" => "StatusConfirmed",
                    "pending" => "StatusPending",
                    "cancelled" => "StatusCancelled",
                    _ => null
                };
                var statusClass = item.Status?.ToString()?.ToLower() switch
                {
                    "confirmed" => "text-bg-success",
                    "pending" => "text-bg-warning",
                    "cancelled" => "text-bg-danger",
                    _ => "text-bg-secondary"
                };
                var statusText = statusKey != null ? Localizer[statusKey].Value : item.Status?.ToString();
                <div class="card shadow-sm h-100 position-relative">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <a class="text-decoration-none fw-semibold"
                               asp-controller="Users" asp-action="Edit" asp-route-id="@item.User.Id">
                                @item.User.FirstName @item.User.LastName
                            </a>
                            <span class="badge rounded-pill @statusClass">@statusText</span>
                        </div>
                        <p class="mb-2 text-muted small text-uppercase">@item.Field.Name</p>
                        <div class="d-flex align-items-center gap-2 small">
                            <span>@item.StartDateTime.ToString("MMM d, HH:mm")</span>
                            <span class="text-muted">&rarr;</span>
                            <span>@item.EndDateTime.ToString("MMM d, HH:mm")</span>
                        </div>
                        <a asp-controller="Booking" asp-action="Details" asp-route-id="@item.Id" class="stretched-link"></a>
                    </div>
                </div>
            }
        </div>
    }
</div>