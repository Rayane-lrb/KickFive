    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model KickFive.Models.Booking
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"];
    var isAdmin = User.IsInRole("Admin");
    var statusLower = Model.Status.ToString().ToLower();
    var statusClass = statusLower switch
    {
        "confirmed" => "text-bg-success",
        "pending" => "text-bg-warning",
        "cancelled" => "text-bg-danger",
        _ => "text-bg-secondary"
    };
    var statusKey = statusLower switch
    {
        "confirmed" => "StatusConfirmed",
        "pending" => "StatusPending",
        "cancelled" => "StatusCancelled",
        _ => null
    };
    var statusText = statusKey != null ? Localizer[statusKey].Value : Model.Status.ToString();
}
<div class="container py-4" style="max-width: 640px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">@Localizer["PageTitle"]</h1>
            <p class="text-muted mb-0">@Localizer["ReservationNumber", Model.Id]</p>
        </div>
        <span class="badge rounded-pill @statusClass">@statusText</span>
    </div>
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-4 text-muted fw-normal">@Localizer["BookedBy"]</dt>
                <dd class="col-8">
                    <a class="text-decoration-none fw-semibold"
                       asp-controller="Users" asp-action="Edit" asp-route-id="@Model.User.Id">
                        @Model.User.FirstName @Model.User.LastName
                    </a>
                </dd>
                <dt class="col-4 text-muted fw-normal">@Localizer["Field"]</dt>
                <dd class="col-8">@Model.Field.Name</dd>
                <dt class="col-4 text-muted fw-normal">@Localizer["Start"]</dt>
                <dd class="col-8">@Model.StartDateTime.ToString("dddd d MMMM yyyy, HH:mm")</dd>
                <dt class="col-4 text-muted fw-normal">@Localizer["End"]</dt>
                <dd class="col-8">@Model.EndDateTime.ToString("dddd d MMMM yyyy, HH:mm")</dd>
                <dt class="col-4 text-muted fw-normal">@Localizer["Status"]</dt>
                <dd class="col-8">
                    <span class="badge rounded-pill @statusClass">@statusText</span>
                </dd>
            </dl>
            @if (isAdmin)
            {
                <div class="pt-3 mt-3 border-top">
                    <p class="text-muted small mb-2">@Localizer["ChangeStatus"]</p>
                    <div class="d-flex gap-2">
                        @if (statusLower != "confirmed")
                        {
                            <form asp-controller="Booking" asp-action="Confirm" asp-route-id="@Model.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-success btn-sm">@Localizer["ConfirmBooking"]</button>
                            </form>
                        }
                        @if (statusLower != "cancelled")
                        {
                            <form asp-controller="Booking" asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">@Localizer["CancelBooking"]</button>
                            </form>
                        }
                    </div>
                </div>
            }
            <div class="d-flex justify-content-end gap-2 pt-4 mt-4 border-top">
                <a asp-controller="Booking" asp-action="Index" class="btn btn-light">@Localizer["BackToBookings"]</a>
            </div>
        </div>
    </div>
</div>