@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model KickFive.Models.Booking

@{
    ViewData["Title"] = "Booking details";
    var isAdmin = User.IsInRole("Admin");

    var statusClass = Model.Status.ToString().ToLower() switch
    {
        "confirmed" => "text-bg-success",
        "pending" => "text-bg-warning",
        "cancelled" => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}

<div class="container py-4" style="max-width: 640px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Booking details</h1>
            <p class="text-muted mb-0">Reservation #@Model.Id</p>
        </div>
        <span class="badge rounded-pill @statusClass">@Model.Status</span>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-4 text-muted fw-normal">Booked by</dt>
                <dd class="col-8">
                    <a class="text-decoration-none fw-semibold"
                       asp-controller="Users" asp-action="Edit" asp-route-id="@Model.User.Id">
                        @Model.User.FirstName @Model.User.LastName
                    </a>
                </dd>

                <dt class="col-4 text-muted fw-normal">Field</dt>
                <dd class="col-8">@Model.Field.Name</dd>

                <dt class="col-4 text-muted fw-normal">Start</dt>
                <dd class="col-8">@Model.StartDateTime.ToString("dddd d MMMM yyyy, HH:mm")</dd>

                <dt class="col-4 text-muted fw-normal">End</dt>
                <dd class="col-8">@Model.EndDateTime.ToString("dddd d MMMM yyyy, HH:mm")</dd>

                <dt class="col-4 text-muted fw-normal">Status</dt>
                <dd class="col-8">
                    <span class="badge rounded-pill @statusClass">@Model.Status</span>
                </dd>
            </dl>

            @if (isAdmin)
            {
                <div class="pt-3 mt-3 border-top">
                    <p class="text-muted small mb-2">Change status</p>
                    <div class="d-flex gap-2">
                        @if (Model.Status.ToString().ToLower() != "confirmed")
                        {
                            <form asp-controller="Booking" asp-action="Confirm" asp-route-id="@Model.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-success btn-sm">Confirm booking</button>
                            </form>
                        }
                        @if (Model.Status.ToString().ToLower() != "cancelled")
                        {
                            <form asp-controller="Booking" asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">Cancel booking</button>
                            </form>
                        }
                    </div>
                </div>
            }

            <div class="d-flex justify-content-end gap-2 pt-4 mt-4 border-top">
                <a asp-controller="Booking" asp-action="Index" class="btn btn-light">Back to bookings</a>
            </div>
        </div>
    </div>
</div>