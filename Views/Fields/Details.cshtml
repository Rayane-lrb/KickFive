@model KickFive.Models.Field
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer localizer
@{
    ViewData["Title"] = "Details";
}
<h1>@localizer["FieldsDetails_Title"]</h1>
<div>
    <h4>@localizer["FieldsDetails_Field"]</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">@localizer["FieldsDetails_Edit"]</a> |
    <a asp-action="Index">@localizer["FieldsDetails_BackToList"]</a>
</div>