@model IEnumerable<KickFive.Models.Field>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer localizer
@{
    ViewData["Title"] = "Index";
}
<h1>@localizer["Fields_Title"]</h1>
<p>
    <a asp-action="Create">@localizer["Fields_CreateNew"]</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Name)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">@localizer["Fields_Edit"]</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">@localizer["Fields_Details"]</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">@localizer["Fields_Delete"]</a>
                </td>
            </tr>
        }
    </tbody>
</table>