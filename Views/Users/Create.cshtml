@model KickFive.Models.User

<div class="container py-4" style="max-width: 640px;">
    <div class="mb-4">
        <h1 class="h3 mb-1">Create user</h1>
        <p class="text-muted mb-0">Add a new user to the system</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" asp-for="FirstName">First name</label>
                        <input class="form-control" asp-for="FirstName" />
                        <span class="text-danger small" asp-validation-for="FirstName"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" asp-for="LastName">Last name</label>
                        <input class="form-control" asp-for="LastName" />
                        <span class="text-danger small" asp-validation-for="LastName"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Email">Email</label>
                    <input class="form-control" asp-for="Email" type="email" />
                    <span class="text-danger small" asp-validation-for="Email"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="PhoneNumber">Phone number</label>
                    <input class="form-control" asp-for="PhoneNumber" />
                    <span class="text-danger small" asp-validation-for="PhoneNumber"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="Password">Password</label>
                    <input class="form-control" type="password" id="Password" name="Password" />
                </div>

                <hr class="my-4" />

                <div class="mb-4">
                    <label class="form-label" for="role">Role</label>
                    <select class="form-select" name="role" id="role">
                        <option value="">Select role</option>
                        @foreach (var r in (List<Microsoft.AspNetCore.Identity.IdentityRole>)ViewBag.Roles)
                        {
                            <option value="@r.Name">@r.Name</option>
                        }
                    </select>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                    <a asp-action="Index" class="btn btn-light">Cancel</a>
                    <button type="submit" class="btn btn-primary">Create user</button>
                </div>
            </form>
        </div>
    </div>
</div>